#
# Copy to .env (git-ignored) and fill in. Never commit .env.
# Run scripts with:  node --env-file=.env scripts/wallet-status.mjs

# 0x-prefixed 32-byte hex (66 chars). Use a THROWAWAY dev key, never a personal wallet.
PRIVATE_KEY=

# Leave empty (or anything but "mainnet") for testnet. Set EXACTLY to "mainnet" to spend real value.
NETWORK=

# Optional commercial RPC key (mainnet). Unset simply drops that failover rung; public RPC still works.
ALCHEMY_API_KEY=
