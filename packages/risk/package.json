{
  "name": "robinhood-risk",
  "version": "0.1.0",
  "description": "Trust-assumption model, accessible risk disclosure UI, a persisted pre-transaction acknowledgment gate, and a sequencer liveness monitor for Robinhood Chain (Arbitrum Orbit L2, 4663/46630). Value-moving flows degrade correctly when the operator's assumptions stop holding.",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "exports": {
    ".": {
      "import": "./index.js",
      "default": "./index.js"
    },
    "./assumptions": "./src/assumptions.js",
    "./liveness": "./src/liveness.js",
    "./disclosure": "./src/disclosure.js",
    "./gate": "./src/gate.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "monitor": "node ../../scripts/liveness.mjs"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "viem": "^2.21.0"
  },
  "keywords": [
    "robinhood",
    "robinhood-chain",
    "arbitrum-orbit",
    "layer2",
    "l2",
    "risk",
    "trust-assumptions",
    "sequencer",
    "liveness",
    "disclosure",
    "viem",
    "web3"
  ],
  "author": "nirholas (https://github.com/nirholas)",
  "license": "UNLICENSED",
  "homepage": "https://github.com/nirholas/robinhood-toolkit/tree/main/packages/risk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirholas/robinhood-toolkit.git",
    "directory": "packages/risk"
  },
  "bugs": {
    "url": "https://github.com/nirholas/robinhood-toolkit/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
