{
  "name": "@nirholas/rh-mcp",
  "version": "0.1.0",
  "description": "Client-side tooling for a Robinhood Trading MCP connection: enumerate and diff the live tool surface, and enforce policy guardrails on agent-initiated writes before they leave your machine.",
  "type": "module",
  "main": "./policy.mjs",
  "exports": {
    ".": "./policy.mjs",
    "./policy": "./policy.mjs",
    "./enumerate": "./enumerate.mjs",
    "./adapter": "./adapter.mjs",
    "./crypto-readiness": "./crypto-readiness.mjs",
    "./route": "./route.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "enumerate.mjs",
    "check-drift.mjs",
    "policy.mjs",
    "adapter.mjs",
    "crypto-readiness.mjs",
    "route.mjs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "crypto-watch": "node ../../examples/mcp-crypto-watch.mjs",
    "enumerate": "node enumerate.mjs",
    "check-drift": "node check-drift.mjs",
    "capabilities": "node ../../examples/mcp-capabilities.mjs"
  },
  "keywords": [
    "robinhood",
    "robinhood-mcp",
    "robinhood-trading",
    "mcp",
    "model-context-protocol",
    "tool-discovery",
    "oauth",
    "pkce",
    "ai-agent",
    "guardrails",
    "policy",
    "trading",
    "risk"
  ],
  "author": "nirholas (https://github.com/nirholas)",
  "license": "UNLICENSED",
  "homepage": "https://github.com/nirholas/robinhood-toolkit/tree/main/packages/rh-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirholas/robinhood-toolkit.git",
    "directory": "packages/rh-mcp"
  },
  "bugs": {
    "url": "https://github.com/nirholas/robinhood-toolkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "overrides": {
    "hono@>=4.12.4 <4.13.11": "^4.13.11",
    "hono@<4.13.7": "^4.13.11",
    "hono@<4.13.5": "^4.13.11",
    "hono@>=3.8.0 <4.12.34": "^4.13.11",
    "hono@>=4.7.0 <4.12.34": "^4.13.11",
    "hono@>=4.12.0 <4.12.34": "^4.13.11",
    "hono@<4.12.34": "^4.13.11",
    "proxy-addr@>=1.1.0 <2.0.8": "^2.0.8"
  }
}
