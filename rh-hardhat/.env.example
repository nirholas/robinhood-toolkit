# robinhood-toolkit · Hardhat environment template for Robinhood Chain
# Author: nirholas · https://github.com/nirholas/robinhood-toolkit
# License: All Rights Reserved (c) 2026 nirholas
#
# Copy to .env and fill in. .env is gitignored — never commit a real key.
# The preferred path is the encrypted keystore instead of a plaintext key here:
#   npx hardhat keystore set RH_DEPLOYER_KEY
# Use this file only as a documented downgrade when the keystore plugin is
# unavailable, and confirm .env is gitignored before your first commit.

# Deployer EOA private key (0x-prefixed). Fund it on chain 46630 before deploy.
RH_DEPLOYER_KEY=

# RPC overrides. Leave unset to use the built-in public endpoints.
RH_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com

# Optional constructor note written into the Beacon and the deployment record.
BEACON_NOTE=robinhood-toolkit
