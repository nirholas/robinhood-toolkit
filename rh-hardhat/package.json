{
  "name": "@robinhood-toolkit/rh-hardhat",
  "version": "0.1.0",
  "private": true,
  "description": "Hardhat project configured to compile, deploy, and verify on both Robinhood Chain networks (4663 mainnet, 46630 testnet).",
  "license": "UNLICENSED",
  "author": "nirholas (https://github.com/nirholas)",
  "homepage": "https://github.com/nirholas/robinhood-toolkit",
  "scripts": {
    "compile": "hardhat compile",
    "deploy:testnet": "hardhat run scripts/deploy-beacon.ts --network rhTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy-beacon.ts --network rhMainnet",
    "test": "hardhat test mocha",
    "typecheck": "hardhat compile && tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.2",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "chai": "^6.3.0",
    "ethers": "^6.17.0",
    "hardhat": "^3.21.2",
    "mocha": "^12.0.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.10"
  },
  "type": "module"
}
